# ---------------------------------------------------------------------------
# ARC Stay — environment template
# Copy to .env (`cp .env.example .env`) and fill in. NEVER commit .env.
# The POC runs end to end with ONLY the two DATABASE_* values below set.
# Every integration is optional and falls back to a deterministic mock.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://arc:arc@127.0.0.1:5432/arc_stay?schema=public"
# Separate database used by `npm run test:integration`. It is reset on each run.
TEST_DATABASE_URL="postgresql://arc:arc@127.0.0.1:5432/arc_stay_test?schema=public"

# --- Session signing --------------------------------------------------------
# Any string >= 32 chars. A development default is used when unset so the POC
# boots with no configuration; ALWAYS set this explicitly outside development.
AUTH_SECRET=""

# --- Demo / safety switches -------------------------------------------------
# "demo" labels all money and metrics as synthetic and blocks live payments.
ARC_DATA_MODE="demo"
# Hard kill switch for outbound guest messaging. Never enable in the POC.
ARC_ENABLE_OUTBOUND_MESSAGING="false"

# --- AI provider (optional) -------------------------------------------------
# "mock" (default) = deterministic fixtures, zero network, zero cost.
# "anthropic" = live provider; requires ANTHROPIC_API_KEY.
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
AI_MAX_TOKENS="2048"
# Per-user AI calls allowed per rolling minute.
AI_RATE_LIMIT_PER_MINUTE="10"

# --- Payments (optional, MVP) -----------------------------------------------
# "simulated" (default) = no network, no charges. Live keys are refused while
# ARC_DATA_MODE=demo.
PAYMENTS_PROVIDER="simulated"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Maps / routing (optional) ----------------------------------------------
# "fixture" (default) = seeded travel-time matrix for Puerto Escondido.
MAPS_PROVIDER="fixture"
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# --- Weather & surf conditions (optional) -----------------------------------
# "fixture" (default) = seeded seven-day conditions. Readings are ALWAYS
# rendered with a freshness timestamp and never as a safety guarantee.
CONDITIONS_PROVIDER="fixture"
STORMGLASS_API_KEY=""
OPENWEATHER_API_KEY=""

# --- Messaging (optional, MVP) ----------------------------------------------
MESSAGING_PROVIDER="noop"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
RESEND_API_KEY=""

# --- Observability (optional, MVP) ------------------------------------------
ANALYTICS_PROVIDER="internal"
POSTHOG_KEY=""
SENTRY_DSN=""
