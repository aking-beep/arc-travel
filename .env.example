# ---------------------------------------------------------------------------
# ARC Stay — environment template
# Copy to .env (`cp .env.example .env`) and fill in. NEVER commit .env.
# The POC runs end to end with ONLY the two DATABASE_* values below set.
# Every integration is optional and falls back to a deterministic mock.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# Every environment sets this. The one exception is a managed Postgres attached
# through a hosting provider's storage integration, which may write the
# connection string under a prefixed name such as MYPREFIX_DATABASE_URL; that is
# picked up automatically. See src/lib/database-url.ts.
DATABASE_URL="postgresql://arc:arc@127.0.0.1:5432/arc_stay?schema=public"
# Separate database used by `npm run test:integration`. It is reset on each run.
TEST_DATABASE_URL="postgresql://arc:arc@127.0.0.1:5432/arc_stay_test?schema=public"

# --- Secrets ----------------------------------------------------------------
# Each any string >= 32 chars. Development defaults are used when unset so the
# POC boots with no configuration; ALWAYS set both explicitly outside
# development, and keep them DIFFERENT from each other — reusing the session
# key as the analytics salt would let anyone who can read the analytics table
# test guesses against the key that signs sessions.
AUTH_SECRET=""
ANALYTICS_SALT=""

# --- Hosted demo front door (optional) --------------------------------------
# Shared passphrase for a hosted walkthrough. Unset (the default) means no
# gate, which is what local development and the test suites want. When set,
# every route redirects to /gate until the passphrase is entered. It locks the
# front door only: the demo sign-in behind it still hands out a session with no
# credential, and every role and tenant check still re-derives from the
# database. Requires AUTH_SECRET, which keys the cookie. Compared trimmed and
# case-folded, so a phone keyboard's capital letter does not lock anyone out.
ARC_DEMO_PASSPHRASE=""

# --- Demo / safety switches -------------------------------------------------
# "demo" labels all money and metrics as synthetic and blocks live payments.
ARC_DATA_MODE="demo"
# Hard kill switch for outbound guest messaging. Never enable in the POC.
ARC_ENABLE_OUTBOUND_MESSAGING="false"

# --- AI provider (optional) -------------------------------------------------
# "mock" (default) = deterministic fixtures, zero network, zero cost.
# "anthropic" = live provider; requires ANTHROPIC_API_KEY.
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
AI_MAX_TOKENS="2048"
# Per-user AI calls allowed per rolling minute.
AI_RATE_LIMIT_PER_MINUTE="10"

# --- Payments (optional, MVP) -----------------------------------------------
# "simulated" (default) = no network, no charges. Live keys are refused while
# ARC_DATA_MODE=demo.
PAYMENTS_PROVIDER="simulated"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Maps / routing (optional) ----------------------------------------------
# "fixture" (default) = seeded travel-time matrix for Puerto Escondido.
MAPS_PROVIDER="fixture"
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# --- Weather & surf conditions (optional) -----------------------------------
# "fixture" (default) = seeded seven-day conditions. Readings are ALWAYS
# rendered with a freshness timestamp and never as a safety guarantee.
CONDITIONS_PROVIDER="fixture"
STORMGLASS_API_KEY=""
OPENWEATHER_API_KEY=""

# --- Travel advice / culture context (optional) -----------------------------
# "fixture" (default) = a GOV.UK-shaped demo payload in the repository, offline.
# "govuk" = the live GOV.UK Content API (no key). Refused while
# ARC_DATA_MODE=demo. Output is always labelled advisory, never law.
TRAVEL_ADVICE_PROVIDER="fixture"

# --- Messaging (optional, MVP) ----------------------------------------------
MESSAGING_PROVIDER="noop"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
RESEND_API_KEY=""

# --- Observability (optional, MVP) ------------------------------------------
ANALYTICS_PROVIDER="internal"
POSTHOG_KEY=""
SENTRY_DSN=""
