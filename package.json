{
  "name": "arc-stay",
  "version": "0.1.0",
  "private": true,
  "description": "ARC Stay — AI-powered destination commerce for independent boutique hotels. POC: Puerto Escondido, Oaxaca.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force --skip-generate",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push --accept-data-loss && npm run db:constraints && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "lint:fix": "eslint . --fix",
    "db:constraints": "prisma db execute --file prisma/constraints.sql --schema prisma/schema.prisma",
    "db:ensure-seed": "tsx prisma/ensure-seed.ts",
    "vercel-build": "prisma generate && prisma db push --accept-data-loss && npm run db:constraints && npm run db:ensure-seed && next build"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@stripe/stripe-js": "10.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^18.0.8",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
